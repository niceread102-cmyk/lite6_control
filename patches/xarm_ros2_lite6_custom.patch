+        geometry_radius=geometry_radius,
+        geometry_length=geometry_length,
+        geometry_width=geometry_width,
+        geometry_mesh_filename=geometry_mesh_filename,
+        geometry_mesh_origin_xyz=geometry_mesh_origin_xyz,
+        geometry_mesh_origin_rpy=geometry_mesh_origin_rpy,
+        geometry_mesh_tcp_xyz=geometry_mesh_tcp_xyz,
+        geometry_mesh_tcp_rpy=geometry_mesh_tcp_rpy,
+    ).robot_description(
+        # Wrist-camera build: pre-expanded lite6_complete_fake.urdf instead of
+        # re-running xarm_device.urdf.xacro. It's a plain URDF (no xacro:arg),
+        # so mappings={}. Hardware plugin is UFRobotFakeSystemHardware baked
+        # in (see lite6_complete_fake.urdf) — needed since this is a plain
+        # URDF and can't receive the ros2_control_plugin xacro mapping above.
+        file_path=os.path.join(get_package_share_directory('xarm_description'), 'urdf', 'lite6_complete_fake.urdf'),
+        mappings={},
+    ).to_moveit_configs()
+    
+    # robot description launch
